{
  "name": "wheelersapp",
  "main": "./index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:rider": "APP_VARIANT=rider EXPO_PUBLIC_APP_VARIANT=rider expo start",
    "start:driver": "APP_VARIANT=driver EXPO_PUBLIC_APP_VARIANT=driver expo start",
    "start:rider:sandbox": "EXPO_PUBLIC_API_BASE_URL=http://localhost:4000 APP_VARIANT=rider EXPO_PUBLIC_APP_VARIANT=rider expo start",
    "start:driver:sandbox": "EXPO_PUBLIC_API_BASE_URL=http://localhost:4000 APP_VARIANT=driver EXPO_PUBLIC_APP_VARIANT=driver expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:rider": "APP_VARIANT=rider EXPO_PUBLIC_APP_VARIANT=rider expo run:android",
    "android:driver": "APP_VARIANT=driver EXPO_PUBLIC_APP_VARIANT=driver expo run:android",
    "ios": "expo run:ios",
    "ios:rider": "APP_VARIANT=rider EXPO_PUBLIC_APP_VARIANT=rider expo run:ios",
    "ios:driver": "APP_VARIANT=driver EXPO_PUBLIC_APP_VARIANT=driver expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "ios:use:rider": "bash scripts/ios-variant.sh rider",
    "ios:use:driver": "bash scripts/ios-variant.sh driver",
    "test": "node --test __tests__/*.test.mjs"
  },
  "dependencies": {
